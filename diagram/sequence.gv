// dot -Tpng -Gdpi=300 sequence.gv -o sequence.png

digraph Sequence {
    rankdir=LR;
    fontname="Helvetica";
    fontsize=11;
    node [fontname="Helvetica", fontsize=11, margin="0.2,0.12"];
    edge [fontname="Helvetica", fontsize=9];
    nodesep=0.5;
    ranksep=0.9;

    // Actors
    Agent  [shape=box, style=filled, fillcolor=white, label="Agent"];
    Queue  [shape=box, style=filled, fillcolor=white, label="Local Queue"];
    Server [shape=box, style=filled, fillcolor=white, label="Server"];
    DB     [shape=cylinder, style=filled, fillcolor=white, label="PostgreSQL"];
    Admin  [shape=box, style=filled, fillcolor=white, label="Admin / Web UI"];

    // --- Registration ---
    subgraph cluster_reg {
        label="1. Registration (first run)";
        style=dashed;
        fontname="Helvetica";
        fontsize=10;

        r1 [label="send register_token", shape=plaintext];
        r2 [label="receive api_key", shape=plaintext];
    }

    // --- Config ---
    subgraph cluster_cfg {
        label="2. Config Fetch";
        style=dashed;
        fontname="Helvetica";
        fontsize=10;

        c1 [label="GET /api/config\n(Bearer token)", shape=plaintext];
        c2 [label="paths + max_file_size_mb", shape=plaintext];
    }

    // --- Hash ---
    subgraph cluster_hash {
        label="3. Hash and Submit";
        style=dashed;
        fontname="Helvetica";
        fontsize=10;

        h1 [label="hash each file (SHA-256)", shape=plaintext];
        h2 [label="POST /api/store\n(Bearer token)", shape=plaintext];
        h3 [label="INSERT hash_records", shape=plaintext];
    }

    // --- Failure ---
    subgraph cluster_fail {
        label="4. Failure Path";
        style=dashed;
        fontname="Helvetica";
        fontsize=10;

        f1 [label="save to queue", shape=plaintext];
        f2 [label="retry on next run", shape=plaintext];
    }

    // --- View ---
    subgraph cluster_view {
        label="5. Admin View";
        style=dashed;
        fontname="Helvetica";
        fontsize=10;

        v1 [label="GET /api/hashes\n(session auth)", shape=plaintext];
        v2 [label="SELECT + compare", shape=plaintext];
        v3 [label="display timeline\n+ alerts", shape=plaintext];
    }

    // Registration
    Agent -> r1 -> Server;
    Server -> r2 -> Agent;

    // Config
    Agent -> c1 -> Server;
    Server -> c2 -> Agent;

    // Hash
    Agent -> h1 -> h2 -> Server;
    Server -> h3 -> DB;

    // Failure
    h2 -> f1 [style=dashed, color=gray, label="on failure"];
    f1 -> Queue;
    Queue -> f2 [style=dashed, color=gray];
    f2 -> Server [style=dashed, color=gray];

    // View
    Admin -> v1 -> Server;
    Server -> v2 -> DB;
    DB -> v3 -> Admin;
}
