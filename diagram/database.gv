// dot -Tpng -Gdpi=300 database.gv -o database.png

digraph Database {
    rankdir=TB;
    fontname="Helvetica";
    fontsize=11;
    node [shape=plaintext, fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];
    nodesep=0.6;
    ranksep=0.8;

    hash_records [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="6">
            <tr><td colspan="2"><b>hash_records</b></td></tr>
            <tr><td align="left"><b>id</b></td><td align="left">SERIAL PRIMARY KEY</td></tr>
            <tr><td align="left">timestamp</td><td align="left">TIMESTAMPTZ NOT NULL</td></tr>
            <tr><td align="left">agent_id</td><td align="left">TEXT NOT NULL</td></tr>
            <tr><td align="left">hashes</td><td align="left">JSONB NOT NULL</td></tr>
        </table>
    >];

    watch_config [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="6">
            <tr><td colspan="2"><b>watch_config</b></td></tr>
            <tr><td align="left"><b>agent_id</b></td><td align="left">TEXT PRIMARY KEY</td></tr>
            <tr><td align="left">paths</td><td align="left">JSONB NOT NULL</td></tr>
            <tr><td align="left">max_file_size_mb</td><td align="left">INTEGER NOT NULL</td></tr>
        </table>
    >];

    idx [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="6">
            <tr><td><b>Index</b></td></tr>
            <tr><td align="left">idx_timestamp_agent</td></tr>
            <tr><td align="left">(timestamp, agent_id)</td></tr>
        </table>
    >];

    hashes_example [label=<
        <table border="0" cellborder="1" cellspacing="0" cellpadding="6">
            <tr><td><b>hashes (JSONB)</b></td></tr>
            <tr><td align="left">"/etc/passwd": "a3f1..."</td></tr>
            <tr><td align="left">"/boot/vmlinuz": "9b2c..."</td></tr>
            <tr><td align="left">"/usr/bin/ls": "d4e7..."</td></tr>
        </table>
    >];

    hash_records -> idx          [label="indexed by", style=dashed];
    hash_records -> hashes_example [label="example value", style=dotted];
    watch_config -> hash_records [label="agent_id", style=dashed, dir=none];
}
