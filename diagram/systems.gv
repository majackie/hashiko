// dot -Tpng -Gdpi=300 systems.gv -o systems.png

digraph Systems {
    rankdir=LR;
    fontname="Helvetica";
    fontsize=11;
    node [fontname="Helvetica", fontsize=11, margin="0.25,0.15", style=filled, fillcolor=white];
    edge [fontname="Helvetica", fontsize=9];
    nodesep=0.5;
    ranksep=1.0;

    subgraph cluster_agent {
        label="Linux Agent (Go)";
        fontname="Helvetica";
        fontsize=11;
        style=rounded;

        Agent [label="Agent\nhashFiles()"];
        Queue [label="Local Queue\n./queue/"];
        AgentCfg [label="/etc/hashiko/\napi_key, watch.conf", shape=note];
    }

    subgraph cluster_server {
        label="Central Server — Render (Flask)";
        fontname="Helvetica";
        fontsize=11;
        style=rounded;

        Register [label="POST /api/register"];
        Store    [label="POST /api/store"];
        Config   [label="GET /api/config"];
        Hashes   [label="GET /api/hashes"];
        CfgSave  [label="POST /api/config\n(admin)"];
        Login    [label="POST /api/login"];
        Static   [label="Static Files\n(HTML/CSS/JS)"];
    }

    subgraph cluster_db {
        label="PostgreSQL — Supabase";
        fontname="Helvetica";
        fontsize=11;
        style=rounded;

        HR  [label="hash_records\n(JSONB hashes)", shape=box];
        WC  [label="watch_config\n(paths, threshold)", shape=box];
    }

    subgraph cluster_ui {
        label="Web UI";
        fontname="Helvetica";
        fontsize=11;
        style=rounded;

        UI [label="Timeline\nAlerts\nConfig Panel"];
    }

    // Agent flows
    AgentCfg -> Agent    [label="keys + paths", style=dashed];
    Agent    -> Register [label="register_token\n(first run)", style=dashed];
    Register -> AgentCfg [label="save api_key", style=dashed];
    Agent    -> Config   [label="Bearer token"];
    Config   -> WC       [label="SELECT"];
    Config   -> Agent    [label="paths + threshold"];
    Agent    -> Store    [label="HTTPS POST\nBearer token"];
    Agent    -> Queue    [label="on failure", style=dashed, color=gray];
    Queue    -> Store    [label="retry", style=dashed, color=gray];

    // Server to DB
    Store    -> HR       [label="INSERT"];
    Hashes   -> HR       [label="SELECT"];
    CfgSave  -> WC       [label="UPSERT"];

    // UI flows
    UI -> Login   [label="credentials"];
    UI -> Hashes  [label="session auth"];
    Hashes -> UI  [label="records + changes"];
    UI -> CfgSave [label="session auth"];
    Static -> UI  [style=dotted];
}
