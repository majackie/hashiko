// dot -Tpng systems.gv -o systems.png

digraph Hashiko {
    rankdir=LR;
    node [shape=box, fontsize=10, margin="0.3,0.2"];
    edge [fontsize=8];
    nodesep=0.8;
    ranksep=1.2;

    subgraph cluster_endpoints {
        label="Endpoints";
        style=rounded;

        Agent [label="Linux Agent\n(Go)"];
        Queue [label="Local Queue\n./queue"];
        Config [label="Config\nMonitored Dirs"];
    }

    subgraph cluster_server {
        label="Central Server";
        style=rounded;

        IngestAPI [label="POST /api/store"];
        ViewAPI [label="GET /api/view"];
        StaticServer [label="Static Server"];
    }

    subgraph cluster_storage {
        label="PostgreSQL";
        style=rounded;

        HashRecords [label="hash_records\nTable"];
        Index [label="Composite\nIndex"];
    }

    subgraph cluster_ui {
        label="Web Interface";
        style=rounded;

        HTML [label="index.html"];
        JS [label="script.js"];
        CSS [label="styles.css"];
    }

    // Data flow
    Config -> Agent [xlabel="paths"];
    Agent -> IngestAPI [xlabel="POST JSON"];
    Agent -> Queue [xlabel="offline", style=dashed];
    Queue -> IngestAPI [xlabel="retry", style=dashed];

    IngestAPI -> HashRecords [xlabel="INSERT"];
    HashRecords -> Index [style=dotted];

    ViewAPI -> HashRecords [xlabel="SELECT"];
    ViewAPI -> JS [xlabel="JSON"];

    StaticServer -> HTML;
    HTML -> JS;
    HTML -> CSS;
}
