// dot -Tpng -Gdpi=300 agent.gv -o agent.png

digraph Agent {
    rankdir=TB;
    fontname="Helvetica";
    fontsize=11;
    node [shape=box, fontname="Helvetica", fontsize=11, margin="0.2,0.12", style=filled, fillcolor=white];
    edge [fontname="Helvetica", fontsize=9];
    nodesep=0.4;
    ranksep=0.5;

    // Inputs
    FS    [label="File System", shape=cylinder];
    Cfg   [label="config.go\n(skip paths, size limit)"];
    WCfg  [label="/api/config\n(watch paths, threshold)"];
    ID    [label="getAgentID()\nuser@host (machine-id)"];

    // Core hashing
    HF    [label="hashFiles()\nwalk directory"];
    Skip  [label="shouldSkip()?\nsize > threshold?", shape=diamond];
    HFile [label="hashFile()\nSHA-256"];
    Map   [label="map[path]hash"];

    // Output
    JSON  [label="hashToJson()\ntimestamp, agent_id, hashes"];
    POST  [label="jsonApiCall()\nHTTPS POST /api/store"];

    // Queue
    Q     [label="Local Queue\n./queue/"];
    Retry [label="processQueue()\nretry on next run"];

    // Server
    Srv   [label="Central Server", shape=cylinder];

    // Registration (side note)
    Reg   [label="Registration\n(first run only)\ntoken → api_key", shape=note];

    // Main flow
    FS   -> HF   [label="walk"];
    WCfg -> HF   [label="paths"];
    Cfg  -> Skip [label="rules"];
    HF   -> Skip;
    Skip -> HFile [label="include"];
    Skip -> HF   [label="skip", style=dashed, color=gray];
    HFile -> Map  [label="SHA-256"];
    Map  -> JSON;
    ID   -> JSON  [label="agent_id"];
    JSON -> POST;
    POST -> Srv   [label="HTTPS"];

    // Failure path
    POST -> Q     [label="on failure", style=dashed, color=gray];
    Q    -> Retry [style=dashed, color=gray];
    Retry -> POST [label="retry", style=dashed, color=gray];

    // Registration
    Reg  -> Srv   [style=dotted, color=gray];

    // Layout hints
    { rank=same; Cfg; WCfg; ID; }
    { rank=same; Q; Retry; }
}
